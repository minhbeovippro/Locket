[Script]
LocketGold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://cdn.jsdelivr.net/gh/minhbeovippro/Locket@main/Locket_Gold.js, requires-body=true, max-size=-1, timeout=60

[Header Rewrite]
^https?://api\.revenuecat\.com/.+/(receipts$|subscribers/[^/]+$) delete-header X-RevenueCat-ETag
^https?://api\.revenuecat\.com/.+/(receipts$|subscribers/[^/]+$) delete-header x-revenuecat-etag

[MITM]
hostname = %APPEND% api.revenuecat.com
